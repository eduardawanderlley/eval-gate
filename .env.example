# Copie para .env e preencha. Nunca commite o .env.
ANTHROPIC_API_KEY=

# Modelo que gera as respostas e modelo que julga. Use modelos diferentes
# sempre que possível, para reduzir viés de autoavaliação.
EVAL_MODEL=claude-haiku-5-5
EVAL_JUDGE_MODEL=claude-haiku-5-5

# Preços em USD por milhão de tokens, para o custo estimado do relatório.
# Consulte a tabela de preços atual antes de usar.
EVAL_PRICE_INPUT_PER_MTOK=0
EVAL_PRICE_OUTPUT_PER_MTOK=0
